{
  "name": "codex-plugin-oc",
  "version": "1.0.0",
  "type": "module",
  "description": "Use Codex from OpenCode to review code or delegate tasks. Port of openai/codex-plugin-cc.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "bump-version": "node scripts/bump-version.mjs",
    "check-version": "node scripts/bump-version.mjs --check",
    "test": "node --test tests/*.test.mjs"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "bin": {
    "codex-plugin-oc": "scripts/install.mjs"
  },
  "files": [
    "index.js",
    "commands",
    "agents",
    "plugins",
    "scripts",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "codex",
    "openai",
    "plugin",
    "code-review"
  ]
}
